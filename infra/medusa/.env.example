# Medusa config
PORT=9000
DATABASE_URL=postgres://medusa:medusa@medusa-db:5432/medusa_store?sslmode=disable
REDIS_URL=redis://medusa-redis:6379
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
JWT_SECRET=change_me
COOKIE_SECRET=change_me

# Kobo backend webhook (Medusa -> Spring Boot)
# From inside Docker, use host.docker.internal (extra_hosts configured in compose).
KOBO_BACKEND_WEBHOOK_URL=http://host.docker.internal:8080/api/webhooks/medusa
# Optional: if set, Medusa will sign payloads (HMAC SHA256) and backend should set MEDUSA_WEBHOOK_SECRET to the same value.
KOBO_BACKEND_WEBHOOK_SECRET=
