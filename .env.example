# Core stack (docker-compose.yml)
# Copy to .env and change passwords before pushing to prod.

# Postgres (app)
POSTGRES_DB=social_wallet
POSTGRES_USER=social_wallet
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8082

# API
API_PORT=8080
# In docker, the API should use the internal Keycloak URL by default.
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/social-wallet
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/social-wallet/protocol/openid-connect/certs
